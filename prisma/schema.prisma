// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCREDITATION_OFFICER
  INTERNAL_ACCREDITOR
  PENDING
}

enum Category {
  SYSTEM
  IMPLEMENTATION
  OUTCOME
}

enum Phase {
  PHASE_1
  PHASE_2
}

enum SurveyStatus {
  IN_PROGRESS
  COMPLETE
}

enum SurveyVisitType {
  FIRST
  REVISIT
}

enum AccreditationStatus {
  UNACCREDITED
  ACTIVE
  EXPIRED
}

enum AreaFileType {
  PPP
  COMPLIANCE_REPORT
  NARRATIVE_PROFILE
}

model User {
  id               String             @id @default(uuid())
  firstName        String
  lastName         String
  phoneNumber      String             @unique
  email            String             @unique
  hashedPassword   String
  photoURL         String?
  address          String?
  role             Role               @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  programPersonnel ProgramPersonnel[]
}

model Program {
  id               String             @id @default(uuid())
  name             String
  code             String
  department       String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  folderId         String
  programPersonnel ProgramPersonnel[]
  accreditation    Accreditation?

  @@unique([name, code])
}

model ProgramPersonnel {
  id          String      @id @default(uuid())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  program     Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId   String
  assignedAt  DateTime    @default(now())
  chairPerson TaskForce[]
  taskForceMember TaskForceMember[]

  @@unique([userId, programId])
}

model Instrument {
  id                   String                 @id @default(uuid())
  name                 String
  accreditingBody      String
  area                 Area[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  phaseOneRequirements PhaseOneRequirements[]
  phaseTwoRequirements PhaseTwoRequirements[]

  @@unique([name, accreditingBody])
}

model Area {
  id                  Int                  @id @default(autoincrement())
  label               String
  description         String
  weight              Int
  instrument          Instrument           @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  instrumentId        String
  parameter           Parameter[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  areaFolders         AreaFolder[]
  phaseTwoAreaFolders PhaseTwoAreaFolder[]
}

model Parameter {
  id               Int               @id @default(autoincrement())
  label            String
  description      String
  area             Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
  areaId           Int
  indicator        Indicator[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parameterFolders ParameterFolder[]
}

model Indicator {
  id            Int            @id @default(autoincrement())
  label         String
  description   String
  category      Category
  evidence      String
  parameter     Parameter      @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  parameterId   Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  evidenceFiles EvidenceFile[]
}

model Level {
  id                String          @id @default(uuid())
  rank              Int
  label             String
  phase             Phase
  requiredGrandMean Decimal
  requiredAreaMean  Decimal
  yearsEffective    Int
  accreditations    Accreditation[]
  surveyVisits      SurveyVisit[]
}

model Accreditation {
  id           String              @id @default(uuid())
  program      Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId    String              @unique
  level        Level?              @relation(fields: [currentLevel], references: [id], onDelete: Cascade)
  currentLevel String?
  startsAt     DateTime?
  endsAt       DateTime?
  status       AccreditationStatus @default(UNACCREDITED)
  surveyVisits SurveyVisit[]
}

model SurveyVisit {
  id                   String                @id @default(uuid())
  accreditation        Accreditation         @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  accreditationId      String
  actualSurveyDate     DateTime
  type                 SurveyVisitType
  level                Level                 @relation(fields: [targetLevel], references: [id], onDelete: Cascade)
  targetLevel          String
  phaseOneRequirements PhaseOneRequirements?
  phaseTwoRequirements PhaseTwoRequirements?
  status               SurveyStatus
  createdAt            DateTime              @default(now())
}

model PhaseOneRequirements {
  id               String            @id @default(uuid())
  surveyVisit      SurveyVisit?      @relation(fields: [surveyVisitId], references: [id], onDelete: Cascade)
  surveyVisitId    String?           @unique
  instrument       Instrument        @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  instrumentId     String
  instrumentFolder InstrumentFolder?
}

model InstrumentFolder {
  id                     String                @id @default(uuid())
  phaseOneRequirements   PhaseOneRequirements? @relation(fields: [phaseOneRequirementsId], references: [id], onDelete: Cascade)
  phaseOneRequirementsId String?               @unique
  folderId               String
  areaFolders            AreaFolder[]
}

model AreaFolder {
  id                 String            @id @default(uuid())
  instrumentFolder   InstrumentFolder  @relation(fields: [instrumentFolderId], references: [id], onDelete: Cascade)
  instrumentFolderId String
  folderId           String
  parameterFolders   ParameterFolder[]
  area               Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
  areaId             Int
  areaFiles          AreaFile[]
  complete           Boolean           @default(false)
  taskForce          TaskForce?
}

model ParameterFolder {
  id               String            @id @default(uuid())
  areaFolder       AreaFolder        @relation(fields: [areaFolderId], references: [id], onDelete: Cascade)
  areaFolderId     String
  folderId         String
  indicatorFolders IndicatorFolder[]
  parameter        Parameter         @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  parameterId      Int
  taskForceMember  TaskForceMember?
}

model IndicatorFolder {
  id                String          @id @default(uuid())
  parameterFolder   ParameterFolder @relation(fields: [parameterFolderId], references: [id], onDelete: Cascade)
  parameterFolderId String
  folderId          String
  category          Category
  evidenceFiles     EvidenceFile[]
}

model EvidenceFile {
  id                String          @id @default(uuid())
  indicatorFolder   IndicatorFolder @relation(fields: [indicatorFolderId], references: [id], onDelete: Cascade)
  indicatorFolderId String
  fileId            String
  indicator         Indicator       @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  indicatorId       Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PhaseTwoRequirements {
  id             String          @id @default(uuid())
  surveyVisit    SurveyVisit?    @relation(fields: [surveyVisitId], references: [id], onDelete: Cascade)
  surveyVisitId  String?         @unique
  instrument     Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  instrumentId   String
  phaseTwoFolder PhaseTwoFolder?
}

model PhaseTwoFolder {
  id                     String                @id @default(uuid())
  phaseTwoRequirements   PhaseTwoRequirements? @relation(fields: [phaseTwoRequirementsId], references: [id], onDelete: Cascade)
  phaseTwoRequirementsId String?               @unique
  folderId               String
  phaseTwoAreaFolders    PhaseTwoAreaFolder[]
}

model PhaseTwoAreaFolder {
  id               String         @id @default(uuid())
  phaseTwoFolder   PhaseTwoFolder @relation(fields: [phaseTwoFolderId], references: [id], onDelete: Cascade)
  phaseTwoFolderId String
  folderId         String
  area             Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)
  areaId           Int
  areaFiles        AreaFile[]
}

model AreaFile {
  id                   String              @id @default(uuid())
  phaseOneAreaFolder   AreaFolder?         @relation(fields: [phaseOneAreaFolderId], references: [id])
  phaseOneAreaFolderId String?
  phaseTwoAreaFolder   PhaseTwoAreaFolder? @relation(fields: [phaseTwoAreaFolderId], references: [id])
  phaseTwoAreaFolderId String?
  type                 AreaFileType
  fileId               String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model TaskForce {
  id              String            @id @default(uuid())
  areaFolder      AreaFolder        @relation(fields: [areaFolderId], references: [id], onDelete: Cascade)
  areaFolderId    String            @unique
  chairPerson     ProgramPersonnel  @relation(fields: [chairPersonId], references: [id], onDelete: Cascade)
  chairPersonId   String
  taskForceMember TaskForceMember[]
}

model TaskForceMember {
  id                String          @id @default(uuid())
  programPersonnel  ProgramPersonnel @relation(fields: [programPersonnelId], references: [id])
  programPersonnelId String 
  taskForce         TaskForce       @relation(fields: [taskForceId], references: [id], onDelete: Cascade)
  taskForceId       String
  parameterFolder   ParameterFolder @relation(fields: [parameterFolderId], references: [id], onDelete: Cascade)
  parameterFolderId String          @unique
}
